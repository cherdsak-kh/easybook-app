# Frontend environment — copy to .env.local and adjust as needed.

# Backend origin for PRODUCTION builds (e.g. https://api.example.com).
# Leave empty in development: the Vite dev server (port 2200) proxies /api to the
# backend (port 3300). API types are generated from the backend spec: `npm run gen:api`.
VITE_API_URL=your_api_url

# LINE LIFF app id (from the LINE Developers console). Leave empty for a plain
# dev browser — the app falls back to a generic "Hello, World" greeting.
VITE_LIFF_ID=your_liff_id

# Real-time (Socket.IO) updates on the admin LINE-users page. OPT-OUT: only the exact
# string `false` disables them, so leaving this unset keeps the feature on. This is the
# rollback switch — with it off the page still works from its fetch-all load, it just
# stops updating itself. The socket reuses VITE_API_URL for its origin and the existing
# session cookie for auth, so there is nothing else to configure.
# VITE_WS_ENABLED=false
